# Copied to .env by `make up` (docker compose reads .env for ${VAR} substitution).
# Nothing here is a real secret: LocalStack accepts any credentials.

# Host ports (bound to 127.0.0.1 only)
API_PORT=8420
POSTGRES_PORT=15432
LOCALSTACK_PORT=4566
OLLAMA_PORT=11434

POSTGRES_PASSWORD=patchloop
AWS_REGION=eu-central-1

# mock | ollama (start with: docker compose --profile ollama up -d) | openai
PATCHLOOP_LLM_PROVIDER=mock
PATCHLOOP_OLLAMA_MODEL=qwen2.5-coder:1.5b
PATCHLOOP_LOG_LEVEL=INFO

# For running services/tests on the host against the compose deps (make test-integration):
PATCHLOOP_DATABASE_URL=postgresql+psycopg://patchloop:patchloop@localhost:15432/patchloop
PATCHLOOP_AWS_ENDPOINT_URL=http://localhost:4566
AWS_ACCESS_KEY_ID=test
AWS_SECRET_ACCESS_KEY=test
