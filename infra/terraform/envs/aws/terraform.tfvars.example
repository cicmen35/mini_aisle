# cp terraform.tfvars.example terraform.tfvars   (terraform.tfvars is git-ignored)
aws_account_id    = "123456789012"
region            = "eu-central-1"
alert_email       = "you@example.com"
api_allowed_cidrs = ["203.0.113.7/32"] # curl -s https://checkip.amazonaws.com

# Optional
# llm_provider                  = "openai"   # default "mock"; never a GPU instance
# openai_model                  = "gpt-4o-mini"
# api_desired_count             = 1
# worker_max_tasks              = 2
